{
  "name": "lone-smart-room",
  "productName": "Lone Smart Room",
  "version": "1.4.0",
  "private": true,
  "description": "Lone Smart Room: widget demonstrativo e fonte Android Wake-on-LAN real",
  "main": "main.cjs",
  "author": "Lone Smart Room",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis portable --x64",
    "postinstall": "node node_modules/electron/install.js"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.lone.smartroom",
    "productName": "Lone Smart Room",
    "files": [
      "index.html",
      "styles.css",
      "app.js",
      "main.cjs",
      "preload.cjs",
      "assets/**/*",
      "agent-status.js"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "engines": {
    "node": "22.16.x",
    "npm": "10.9.x"
  },
  "packageManager": "npm@10.9.2"
}
