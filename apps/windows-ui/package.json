{
  "name": "lone-smart-room",
  "productName": "Lone Smart Room",
  "version": "2.0.0-dev.9",
  "private": true,
  "description": "Lone Smart Room: central Windows, monitoramento local e ferramentas seguras",
  "main": "main.cjs",
  "author": "Lone Smart Room",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis portable --x64",
    "postinstall": "node node_modules/electron/install.js",
    "start:review": "electron . --lone-development-review"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.lone.smartroom",
    "productName": "Lone Smart Room",
    "files": [
      "index.html",
      "styles.css",
      "app.js",
      "main.cjs",
      "preload.cjs",
      "assets/**/*",
      "agent-status.js",
      "app-version.js",
      "app-launch.js",
      "desktop.css",
      "desktop.js",
      "desktop-main.cjs",
      "desktop-policy.cjs",
      "desktop-preferences.cjs",
      "desktop-window.cjs",
      "monitoring-host.cjs",
      "monitoring-model.js",
      "monitoring-renderer.js",
      "monitoring.css",
      "monitoring-runtime.cjs",
      "monitoring-package.json",
      "diagnostics-contract.js",
      "diagnostics-model.js",
      "diagnostics-renderer.js",
      "diagnostics-host.cjs",
      "diagnostics-fixtures.json",
      "diagnostics.css",
      "performance-history.cjs",
      "history-renderer.js",
      "history.css",
      "gamer-session.js",
      "gamer-session-renderer.js",
      "gamer-session.css",
      "workbench-model.js",
      "workbench-catalog.cjs",
      "workbench-service.cjs",
      "workbench-renderer.js",
      "workbench.css",
      "windows-read-provider.cjs",
      "windows-inventory.ps1",
      "auxiliary-windows.cjs",
      "panel-preferences.cjs",
      "panel-preload.cjs",
      "panel.html",
      "panel.css",
      "panel.js",
      "local-diagnostics.cjs",
      "agent-evidence-provider.cjs",
      "game-archive.cjs",
      "maintenance-inspector.cjs",
      "audio-session.js",
      "media-permissions.cjs",
      "development-deadline.cjs",
      "presentmon-source.cjs"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/brand/windows-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "asarUnpack": [
      "windows-inventory.ps1"
    ]
  },
  "engines": {
    "node": "22.16.x",
    "npm": "10.9.x"
  },
  "packageManager": "npm@10.9.2"
}
